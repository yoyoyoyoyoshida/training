        </p>
    </main>

    <footer class="footer">
        &copy; 2026 GACHI-CUBE &nbsp;·&nbsp;
        <a
            id="privacy-link"
            href="./privacy.html"
            target="_blank"
            rel="noopener noreferrer"
        >プライバシーポリシー</a>
    </footer>

    <script>
        (function () {
            const ua = navigator.userAgent || navigator.vendor || '';
            const isIPadOS =
                navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1;
            const isIOS = /iPhone|iPad|iPod/i.test(ua) || isIPadOS;
            const isAndroid = /Android/i.test(ua);
            const isMobile = isIOS || isAndroid || /Mobile|webOS|BlackBerry|IEMobile|Opera Mini/i.test(ua);

            if (isIOS) document.body.classList.add('is-ios', 'is-mobile');
            else if (isAndroid) document.body.classList.add('is-android', 'is-mobile');
            else if (isMobile) document.body.classList.add('is-mobile');

            const banner = document.getElementById('platform-banner');
            if (banner) {
                if (isIOS) {
                    banner.textContent = 'iPhone で開いています → App Store から入手';
                } else if (isAndroid) {
                    banner.textContent = 'Android で開いています → Google Play から入手';
                }
            }

            const privacyLink = document.getElementById('privacy-link');
            if (privacyLink) {
                privacyLink.addEventListener('click', function (event) {
                    event.preventDefault();
                    const url = privacyLink.href;
                    const win = window.open(url, '_blank');
                    if (!win) {
                        window.location.href = url;
                    }
                });
            }
        })();
    </script>
</body>
</html>
